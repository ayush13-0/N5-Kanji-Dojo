<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>N5KanjiDojo</AssemblyName>
    <RootNamespace>N5KanjiDojo</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>N5 Kanji Dojo</Product>
    <Company>Ayush</Company>
    <Authors>Ayush</Authors>
    <Copyright>Built by Ayush</Copyright>
    <Description>N5 Kanji Dojo — JLPT N5 kanji, vocabulary, grammar and writing. Fully offline.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="www\index.html" LogicalName="index.html" />
    <EmbeddedResource Include="www\licenses.txt" LogicalName="licenses.txt" />
  </ItemGroup>
</Project>
